{
  "name": "ember",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check:interconnect": "bun scripts/check-interconnect.ts dist/links-control/circuit.json dist/links-main/circuit.json",
    "check:dfm": "bun scripts/check-dfm.ts dist/links-control/circuit.json && bun scripts/check-dfm.ts dist/links-main/circuit.json",
    "export:fab": "bun scripts/export-fab.ts",
    "export:panel": "bun scripts/export-panel.ts",
    "build:single": "tsci build links-single.circuit.tsx --disable-parts-engine && bun run check:single",
    "check:single": "bun scripts/check-links-single.ts && bun scripts/check-dfm.ts dist/links-single/circuit.json",
    "preview:single": "tsci build links-single.circuit.tsx --disable-parts-engine --pcb-png --schematic-png && bun run check:single"
  },
  "devDependencies": {
    "@tscircuit/capacity-autorouter": "0.0.890",
    "@types/react": "^19.2.14",
    "tscircuit": "0.0.2476",
    "typescript": "^5.0.0"
  }
}
